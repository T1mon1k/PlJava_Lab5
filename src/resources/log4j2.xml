<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} [%t] %-5level [%logger] %msg%n"/>
        </Console>

        <File name="FileLog" fileName="src/files/app.log" append="true">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level [%logger] %msg%n"/>
        </File>
    </Appenders>

    <Loggers>

        <Logger name="cipher" level="info" additivity="false">
            <AppenderRef ref="FileLog" level="info" />
            <AppenderRef ref="Console" level="warn" />
        </Logger>

        <Logger name="main" level="info" additivity="false">
            <AppenderRef ref="FileLog" level="info" />
            <AppenderRef ref="Console" level="warn" />
        </Logger>

        <Root level="error">
            <AppenderRef ref="Console"/>
        </Root>

    </Loggers>

</Configuration>